rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================
    // Common Helper Functions
    // ===============================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStudent() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================
    // Users
    // ===============================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isOwner(userId);
      allow list: if isAuthenticated();
    }

    // ===============================
    // Attendance
    // ===============================
    match /attendance/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);

      match /days/{dayId} {
        allow read: if isAdmin() || isOwner(userId);
        allow write: if (isAdmin() || isOwner(userId)) &&
                      request.time.dayOfWeek() >= 1 &&
                      request.time.dayOfWeek() <= 5;
        allow create: if (isAdmin() || isOwner(userId)) &&
                       request.time.dayOfWeek() >= 1 &&
                       request.time.dayOfWeek() <= 5 &&
                       request.resource.data.keys().hasAll(['status', 'createdAt']) &&
                       request.resource.data.status is string &&
                       request.resource.data.status in ['present', 'absent', 'late', 'early'];
      }

      match /events/{eventId} {
        allow read, write: if isAdmin() || isOwner(userId);
      }
    }

    // ===============================
    // GEOFENCE MODULE
    // ===============================

    // Student daily geofence profiles
    match /geofences/{studentId}/days/{dayId} {
      allow read, write: if isOwner(studentId) || isAdmin();
    }

    // Geofence incidents (logs)
    match /geofence_incidents/{studentId}/incidents/{incidentId} {
      allow read, write: if isOwner(studentId) || isAdmin();
    }

    // Weekly student schedule
    match /student_schedules/{studentId} {
      allow read, write: if isOwner(studentId) || isAdmin();
    }

    // Custom geofences (for flexible locations)
    match /student_geofences/{studentId}/days/{dayId} {
      allow read, write: if isOwner(studentId) || isAdmin();
    }

    // Campus default geofence data (admin-editable)
    match /campus_locations/{campusId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===============================
    // Admin & Supporting Collections
    // ===============================
    match /adminActions/{actionId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isAdmin() || isOwner(userId);
    }

    match /users/{userId}/at-risk/{statusId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin() || request.auth == null;
    }

    match /reports/{reportId} {
      allow read, write: if isAuthenticated();
    }

    match /notes/{noteId} {
      allow read, write: if isAuthenticated();
    }

    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /users/{userId}/notes/{noteId} {
      allow read: if isAdmin() || isOwner(userId) || resource.data.visibility == 'public';
      allow write: if isAdmin() || isOwner(userId);
      allow list: if isAdmin() || isOwner(userId);

      allow update: if isAuthenticated() &&
                     resource.data.visibility == 'public' &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy']) &&
                     request.resource.data.title == resource.data.title &&
                     request.resource.data.body == resource.data.body &&
                     request.resource.data.visibility == resource.data.visibility;

      match /reports/{reporterId} {
        allow read, write: if isAdmin() || isOwner(reporterId);
      }
    }

    // ===============================
    // Collection Group Queries (for Admin Dashboards)
    // ===============================
    match /{path=**}/days/{dayId} {
      allow read: if isAdmin();
    }

    match /{path=**}/events/{eventId} {
      allow read: if isAdmin();
    }

    match /{path=**}/notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/notes/{noteId} {
      allow read: if isAuthenticated() &&
                     (resource.data.visibility == 'public' ||
                      resource.data.authorId == request.auth.uid);
    }

    match /{path=**}/reports/{reporterId} {
      allow read: if isAdmin() ||
                     (request.auth != null && request.auth.uid == reporterId);
    }

    match /{path=**}/at-risk/{statusId} {
      allow read: if isAdmin();
    }

    // Default: deny all else
    match /{document=**} {
      allow read: if isAdmin();
    }
  }
}
